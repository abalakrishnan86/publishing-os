ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Postgres (matches docker-compose defaults)
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospass
DATABASE_URL=postgresql://posuser:pospass@localhost:5432/publishingos

# pgAdmin
PGADMIN_EMAIL=admin@publishingos.local
PGADMIN_PASSWORD=admin

# App
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
